{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "itsqmet-comprobantes",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "MAX_UPLOAD_MB": "20"
  }
}
